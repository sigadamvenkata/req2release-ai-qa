# Figma Personal Access Token
# Get yours at: https://www.figma.com/settings → Personal Access Tokens
VITE_FIGMA_TOKEN=your_figma_personal_access_token_here


# Figma File Key (extracted from the URL)
# https://www.figma.com/design/<file_key>/<file_name> → <file_key>
VITE_FIGMA_FILE_KEY=your_figma_file_key_here
